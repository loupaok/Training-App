# Backend Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coach_management

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRATION=7d

# File Upload Configuration
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE=5242880

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration (optional for notifications)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=CoachApp

# Web Push Configuration (optional; push no-ops if unset)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Bank Transfer Details (shown to clients during registration/billing)
BANK_NAME=
BANK_BENEFICIARY=
BANK_IBAN=
BANK_SUPPORT_EMAIL=
BANK_SUPPORT_PHONE=
