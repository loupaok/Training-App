# Copy this file to backend/.env. Never commit the real .env file.
NODE_ENV=development
PORT=5000
# Set this to 1 when the app is behind Nginx, a load balancer, or a hosting proxy.
TRUST_PROXY=

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=coach_app
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=coach_management

# Auth: generate long, unique values per environment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Browser access. Production must list only trusted HTTPS frontend origins.
FRONTEND_URL=http://localhost:3000
# List trusted browser origins only. The native Capacitor schemes are handled by the API.
CORS_ORIGINS=http://localhost:3000,http://192.168.1.4:3000
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=40
JSON_BODY_LIMIT=1mb

# Uploads and image processing
UPLOAD_DIR=uploads
UPLOADS_DIR=uploads
MAX_FILE_SIZE=5242880

# SMTP. These may also be configured from the protected Settings screen.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Coaching App
SMTP_SETTINGS_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Firebase Admin JSON for native push notifications. Keep it on one line.
# Any non-empty value enables delivery when the service-account JSON is present.
FCM_SERVER_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional web push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Bank Transfer Details (shown to clients during registration/billing)
BANK_NAME=
BANK_BENEFICIARY=
BANK_IBAN=
BANK_SUPPORT_EMAIL=
BANK_SUPPORT_PHONE=

# WooCommerce (Points & Rewards coupon integration)
WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_POINTS_RATE=100

# Discord integration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=
DISCORD_SETTINGS_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Local or scheduled backups. On Windows/XAMPP use e.g. C:\\xampp\\mysql\\bin\\mysqldump.exe
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
DB_DUMP_BIN=
