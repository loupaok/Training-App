# Copy this to .env and fill in your values

# Backend Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=coach_management

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=7

# File Upload Configuration
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE=5242880

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Email Configuration (optional for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Bank Transfer Details (shown to clients during registration/billing)
BANK_NAME=Your Bank Name
BANK_BENEFICIARY=Your Business Name
BANK_IBAN=GR00 0000 0000 0000 0000 0000 000
BANK_SUPPORT_EMAIL=support@example.com
BANK_SUPPORT_PHONE=210 000 0000
