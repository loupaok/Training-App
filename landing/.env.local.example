# Public site URL (used for metadata, sitemap, JSON-LD, Keystatic local mode)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Existing coaching app backend (separate project — read-only usage from here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Keystatic — local mode, no GitHub needed. Required by @keystatic/next even in local mode.
NEXT_PUBLIC_KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=change-me-to-a-random-string

# Contact form email delivery (optional — if unset, submissions are just logged server-side)
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
